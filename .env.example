# Sylva configuration. Copy to .env (setup.ps1 does this) and edit as needed.
# Never commit .env. Credentials are read only by the backend and never sent to the browser.

# Where imagery, models, outputs and the SQLite database are stored (default: <repo>/data)
# SYLVA_DATA_DIR=C:\sylva-data

# Imagery catalogue (Element 84 Earth Search, no credentials needed)
SYLVA_STAC_URL=https://earth-search.aws.element84.com/v1
SYLVA_STAC_COLLECTION=sentinel-2-c1-l2a

# Optional: Copernicus Data Space Ecosystem account (free; https://dataspace.copernicus.eu)
# Only needed for the official CDSE provider's authenticated downloads.
SYLVA_CDSE_USERNAME=
SYLVA_CDSE_PASSWORD=

# Compute: auto | cpu | cuda
SYLVA_DEVICE=auto

# Largest AOI (bounding box) accepted, km2
SYLVA_MAX_AOI_KM2=2500

# Allowed browser origins for the API
SYLVA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
